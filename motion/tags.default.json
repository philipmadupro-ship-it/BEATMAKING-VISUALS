{
  "_doc": "Every on-screen text. {vars}: title, Title, producer, bpm, bpm2, key, stage, stageN, look, experiment, date, lufs, srcLufs, lra, tp, bars, songBar. Override any key with --tags my.json (deep merge).",
  "title": "{title}",
  "producer": "@uche2crazy",
  "experiment": "EXP-03",
  "date": "{today}",
  "boot": ["> U2C.EXE  // {look} MODE", "> load {experiment} \"{title}\"", "> trial {bpm2} BPM · {key}", "> stage {stageN}: {stage}", "> run_"],
  "windows": {
    "logo": "chains.dll", "elephant": "elephant.sys", "wave": "session.exe", "spectrum": "spectrum.vst", "spectro": "spectrogram.vst",
    "eq": "eq.vst", "loud": "loudness.exe", "gonio": "gonio.scope", "clock": "clock.sys", "bands": "bands.dat", "scope": "scope.osc",
    "surface": "surface.gl", "terminal": "terminal", "result": "result.txt"
  },
  "codes": { "prefix": "SPC", "trial": "TRIAL {bpm}" },
  "specimen": ["SPECIMEN 05", "ELEPHANT · {stage}", "VERLET · T0 = 2 BEATS"],
  "notes": {
    "loud_old": "SRC {srcLufs} LUFS",
    "loud_new": "→ {lufs} ✓ mastered",
    "spectrum": "808 lives here",
    "wave": "DROP A — we are here",
    "gonio": "corr > 0 ✓ mono-safe",
    "eq": "warm low end vs pink",
    "elephant": "θ = {angle}°"
  },
  "stamps": { "clock": ["TRIAL {bpm}", "GRID LOCKED"], "result": ["RESULT: POSITIVE", "{date}"] },
  "result": {
    "header": "{experiment} · RESULT",
    "title": "{Title}",
    "meta": "{bpm} BPM  ·  {key}  ·  4/4",
    "producer": "prod. {producer}",
    "cta": "full beat → link in bio",
    "measure": "I {lufs} LUFS · LRA {lra} LU · TP {tp} dBTP"
  },
  "bigwords": ["{bpm}", "{keyShort}", "U2C", "{titleWord}", "DROP", "BPM"],
  "hud": { "left": "{experiment} · {stage}", "rec": "REC {tc}", "bottomLeft": "BAR {bbt} · SONG {songBar}", "bottomRight": "prod. {producer}" }
}
